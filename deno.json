{
  "workspace": [
    "./packages/core",
    "./packages/tensor",
    "./packages/models"
  ],
  "tasks": {
    "codegen": "deno run --allow-run --allow-read --allow-write --allow-env packages/core/codegen/generate.ts",
    "chat": "deno run --allow-ffi --allow-env --allow-read --allow-write --allow-net --unstable-ffi examples/chat.ts",
    "demo": "deno run --allow-ffi --allow-env --allow-read --allow-write --allow-net --allow-run --unstable-ffi examples/summarizer/server.ts",
    "test": "deno test --allow-ffi --allow-env --allow-read --unstable-ffi"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 90,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
